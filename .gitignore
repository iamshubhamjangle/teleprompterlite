# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files stay local; only the documented example is public.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.npm-cache/
/test-results/
/playwright-report/
/.impeccable/review/

/.playwright/

# Local audit evidence and history recovery bundles must never be published.
/.audit-local/
*.bundle
/.impeccable/hook.cache.json
/.impeccable/hook.pending.json
/.impeccable/config.local.json
# Original recordings and duplicate exports are local authoring assets.
/demos/
